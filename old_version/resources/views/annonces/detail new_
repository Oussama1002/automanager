antFinance = prixTotal - apport + fraisDossier + assuranceTotale; let paiementMensuel = 0; if (taux > 0) { const tauxMensuel = taux / 100 / 12; paiementMensuel = (montantFinance * tauxMensuel) / (1 - Math.pow(1 + tauxMensuel, -duree)); } else { paiementMensuel = montantFinance / duree; } document.getElementById('montantTotal').textContent = prixTotal.toLocaleString('fr-FR', { minimumFractionDigits: 2 }); document.getElementById('montantApport').textContent = apport.toLocaleString('fr-FR', { minimumFractionDigits: 2 }); document.getElementById('dureeMois').textContent = duree; document.getElementById('paiementMensuel').textContent = paiementMensuel.toLocaleString('fr-FR', { minimumFractionDigits: 2 }); } document.getElementById('clientType').addEventListener('change', updateTauxAutomatique); document.getElementById('apport').addEventListener('input', updateCalculateur); document.getElementById('duree').addEventListener('change', updateCalculateur); // If you want to allow manual taux input (currently hidden), add listener here: // document.getElementById('taux').addEventListener('input', updateCalculateur); window.addEventListener('DOMContentLoaded', () => { updateTauxAutomatique(); updateCalculateur(); }); </script> <script> document.addEventListener('DOMContentLoaded', () => { // Build unified media list (images + optional reel) - keep your Blade loops const mediaList = [ @foreach($annonce->media as $media) { type: 'image', src: "{{ asset('storage/ads/' . $media->name) }}", thumb: "{{ asset('storage/ads/' . $media->name) }}" }, @endforeach @if($annonce->reel) { type: 'video', videoId: "{{ $annonce->reel }}", thumb: "{{ asset('assets/images/play-thumbnail.png') }}" } @endif ]; const mainDisplay = document.getElementById('mainDisplay'); const thumbnailContainer = document.getElementById('thumbnailContainer'); let currentIndex = 0; // Render thumbnails function renderThumbnails() { thumbnailContainer.innerHTML = ''; mediaList.forEach((item, idx) => { if (item.type ===