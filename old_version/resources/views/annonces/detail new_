umber" id="prixTotal" class="w-full rounded px-4 py-2 text-gray-800" value="{{ $annonce->prix }}" readonly> </div> <div> <label class="block mb-1 text-white">À combien s'élève votre apport ?</label> <input type="number" id="apport" class="w-full rounded px-4 py-2 text-gray-800" placeholder="Ex: 50000"> </div> <div> <label class="block mb-1 text-white">Quelle durée vous convient le mieux ?</label> <select id="duree" class="w-full rounded px-4 py-2 text-gray-800"> <option value="12">12 mois</option> <option value="24">24 mois</option> <option value="36">36 mois</option> <option value="48">48 mois</option> <option value="60" selected>60 mois</option> </select> </div> </div> <!-- {{-- ➕ Additional Financial Info --}} <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8"> <div> <label class="block mb-1 text-white">Frais de dossier</label> <input type="text" value="4375 DH" readonly class="w-full rounded px-4 py-2 text-gray-800 bg-gray-100"> </div> <div> <label class="block mb-1 text-white">Assurance annuelle</label> <input type="text" value="235 DH" readonly class="w-full rounded px-4 py-2 text-gray-800 bg-gray-100"> </div> </div> --> <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8"style=""> <div> <label class="block mb-1 text-white">Je suis</label> <select id="clientType" class="w-full rounded px-4 py-2 text-gray-800"> <option value="">-- Choisissez --</option> @foreach ($clientTypes as $type) <option value="{{ $type->id }}" data-taux="{{ $type->taux_interet }}"> {{ $type->name }} </option> @endforeach </select> </div> <!-- <div> <label class="block mb-1 text-white" >Taux d'intérêt (%)</label> <input type="number" id="taux"readonly class="w-full rounded px-4 py-2 text-gray-800" placeholder="Ex: 4.5"> </div> --> </div> {{-- 💰 Financing summary --}} <div class="grid grid-cols-1 md:grid-cols-2 gap-4 justify-items-center text-lg"> <div class="text-left"> <p>Montant Total : <span id="montantTotal">{{ number_format($annonce->prix, 2, '.', ' ') }}</span> DH</p> <p>Mon