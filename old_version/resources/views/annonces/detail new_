ursor: zoom-in;" /> ; const newMainImage = mainDisplay.querySelector('img'); // Desktop: dblclick to open. Touch devices: single tap to open. if ('ontouchstart' in window) { newMainImage.addEventListener('click', () => openLightbox(item.src)); } else { newMainImage.addEventListener('dblclick', () => openLightbox(item.src)); } } else if (item.type === 'video') { mainDisplay.innerHTML = <iframe width="100%" height="400" src="https://www.youtube.com/embed/${item.videoId}?rel=0&modestbranding=1" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen class="rounded w-full" ></iframe> ; } highlightActiveThumbnail(); } // Thumbnail clicks (event delegation) thumbnailContainer.addEventListener('click', e => { let target = e.target; if (!target.dataset.index && target.closest('[data-index]')) { target = target.closest('[data-index]'); } const idx = parseInt(target.dataset.index); if (!isNaN(idx)) renderMain(idx); }); // Prev/Next buttons (guard in case mediaList length <= 1) const nextBtn = document.getElementById('nextBtn'); const prevBtn = document.getElementById('prevBtn'); if (nextBtn) nextBtn.addEventListener('click', () => { if (!mediaList.length) return; renderMain((currentIndex + 1) % mediaList.length); }); if (prevBtn) prevBtn.addEventListener('click', () => { if (!mediaList.length) return; renderMain((currentIndex - 1 + mediaList.length) % mediaList.length); }); // Init renderThumbnails(); if (mediaList.length > 0) { renderMain(0); } }); </script> <!-- End financement section --> <!-- Scripts --> <script> document.querySelectorAll('.tab-link').forEach(link => { link.addEventListener('click', () => { document.querySelectorAll('.tab-link').forEach(l => l.classList.remove('text-yellow-500', 'border-yellow-500', 'border-b-2')); link.classList.add('text-yellow-500', 'border-b-2', 'border-yellow-500'); const tab = link.getAttribute('data-tab'); document.querySelectorAll('.tab-content').forEach(c =>